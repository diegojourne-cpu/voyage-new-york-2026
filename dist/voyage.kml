<name>New York — Noël 2026</name>
<Style id="s0"><IconStyle><color>ff988f8a</color></IconStyle><LineStyle><color>ff988f8a</color><width>4</width></LineStyle></Style>
<Style id="s1"><IconStyle><color>ff2e10c8</color></IconStyle><LineStyle><color>ff2e10c8</color><width>4</width></LineStyle></Style>

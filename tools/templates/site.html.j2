<!-- ================================================================ JEUX -->
<section class="vue" id="v-jeux" hidden>
  <header><div class="eyebrow">Pour les files d'attente</div><h2>{{ ctx.jeux.bingo.titre }}</h2><p class="lead">{{ ctx.jeux.bingo.regle }} <span class="sync" id="sync-bingo"></span></p></header>
  <div class="bingo" id="bingo">{% for c in ctx.jeux.bingo.cases %}<button type="button" data-b="{{ loop.index0 }}" aria-pressed="false">{{ c }}</button>{% endfor %}</div>

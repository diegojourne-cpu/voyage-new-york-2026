  <header><div class="eyebrow">Hors programme</div><h2>Options et idées</h2></header>
  <article class="card" style="display:grid;gap:8px"><div class="eyebrow">Option demi-journée</div><h3 style="font-size:21px;font-stretch:85%">Statue de la Liberté et Ellis Island</h3>
    <dl class="kv" style="margin:0"><dt>Incluse ?</dt><dd>{{ ctx.statue.incluse_dans }}</dd><dt>Meilleur moment</dt><dd>{{ ctx.statue.meilleur_moment }}</dd><dt>Remplace</dt><dd>{{ ctx.statue.creneau_remplace }}</dd><dt>Ce qu'on perd</dt><dd>{{ ctx.statue.ce_qu_on_perd }}</dd><dt>Verdict</dt><dd>{{ ctx.statue.verdict }}</dd></dl>
    <details class="plus"><summary>Déroulé de la matinée</summary><ul style="margin:.5em 0 0;padding-left:1.1em">{% for d in ctx.statue.deroule %}<li class="mono" style="font-size:13px">{{ d }}</li>{% endfor %}</ul></details>
  </article>
  <article class="card" style="display:grid;gap:8px"><div class="eyebrow">Match</div><h3 style="font-size:21px;font-stretch:85%">{{ ctx.match.verdict }}</h3><ul style="margin:0;padding-left:1.1em;display:grid;gap:4px">{% for d in ctx.match.details %}<li>{{ d }}</li>{% endfor %}</ul><p class="pied" style="margin:0">{{ ctx.match.alternative }}</p></article>
  <article class="card" style="display:grid;gap:8px"><div class="eyebrow">Big Apple Greeter</div><h3 style="font-size:21px;font-stretch:85%">{{ ctx.greeter.verdict }}</h3><ul style="margin:0;padding-left:1.1em;display:grid;gap:4px">{% for d in ctx.greeter.details %}<li>{{ d }}</li>{% endfor %}</ul><p style="margin:0"><b>Créneau conseillé :</b> {{ ctx.greeter.creneau_conseille }}</p><div><a class="btn" href="{{ ctx.greeter.lien }}" target="_blank" rel="noopener">Faire la demande ↗</a></div></article>
  <header><div class="eyebrow">Banque d'idées</div><h2>À glisser si l'envie vous prend</h2></header>
  <div class="grid2">{% for a in ctx.autres %}<div class="card" style="display:grid;gap:6px"><h3 style="font-size:17px;font-stretch:88%">{{ a.titre }}</h3><p style="margin:0">{{ a.pourquoi }}</p><p class="pied" style="margin:0"><b>Où le placer :</b> {{ a.ou_le_placer }}</p><p class="pied" style="margin:0">{{ a.prix }}</p></div>{% endfor %}</div>
  <header><div class="eyebrow">Plan pluie / neige</div><h2>Réserve d'activités couvertes</h2><p class="lead">{{ ctx.plan_pluie.principe }}</p></header>
  <div class="grid2">{% for q, l in ctx.plan_pluie.par_quartier.items() %}<div class="card"><b>{{ q }}</b><ul style="margin:.4em 0 0;padding-left:1.1em">{% for x in l %}<li>{{ x }}</li>{% endfor %}</ul></div>{% endfor %}</div>

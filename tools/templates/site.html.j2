<!-- ================================================================ INFOS -->
<section class="vue" id="v-infos" hidden>
  <header><div class="eyebrow">Mode d'emploi</div><h2>Infos pratiques</h2></header>
  <div class="grid2">{% for s in ctx.infos %}<div class="card"><h3 style="font-size:17px;font-stretch:88%">{{ s.titre }}</h3><ul style="margin:.5em 0 0;padding-left:1.1em;display:grid;gap:5px;font-size:14px">{% for p in s.points %}<li>{{ p }}</li>{% endfor %}</ul></div>{% endfor %}
    <div class="card"><h3 style="font-size:17px;font-stretch:88%">Urgences et hôtel</h3><ul style="margin:.5em 0 0;padding-left:1.1em;display:grid;gap:5px;font-size:14px">{% for u in ctx.voyage.urgences %}<li>{{ u }}</li>{% endfor %}<li>{{ ctx.voyage.hotel.adresse }}</li>{% for s in ctx.voyage.hotel.stations %}<li>{{ s }}</li>{% endfor %}</ul></div>
  </div>
  <header><div class="eyebrow">Vérification automatique</div><h2>{{ ctx.nb.erreur }} erreur · {{ ctx.nb.attention }} points à confirmer</h2><p class="lead">Recalculée à chaque modification : horaires d'ouverture à la date prévue, dernières entrées, créneaux réservés, trajets, coucher du soleil, retour à l'hôtel, heure d'arrivée à JFK.</p></header>
  <div class="liste-alertes">{% for a in ctx.alertes %}<div class="alerte {{ a.niveau }}"><span>{{ {'erreur':'❌','attention':'⚠️','info':'ℹ️'}[a.niveau] }}</span><span><span class="mono">{{ a.jour[5:] }}</span> · <b>{{ a.etape }}</b> — {{ a.message }}</span></div>{% endfor %}</div>
  <p class="pied">Généré le {{ ctx.genere_le }} depuis le dépôt GitHub <span class="mono">voyage-new-york-2026</span>. Pour modifier : dites-le à Claude (« il pleut », « on est en retard », « on préfère X »), ou changez <span class="mono">data/programme.yaml</span>.</p>
</section>
</main>

<script id="data" type="application/json">{{ data_json|safe }}</script>
<script>
(() => {
"use strict";
const D = JSON.parse(document.getElementById("data").textContent);
const $ = (s, r = document) => r.querySelector(s), $$ = (s, r = document) => [...r.querySelectorAll(s)];
const pad = n => String(n).padStart(2, "0"), hm = m => pad(Math.floor(m / 60) % 24) + ":" + pad(m % 60);

/* ---------------- routage par #ancre */
const vues = $$("section.vue").map(s => s.id.slice(2));
function route() {
  const h = (location.hash || "#maintenant").slice(1);
  const v = vues.includes(h) ? h : "maintenant";
  $$("section.vue").forEach(s => { s.hidden = s.id !== "v-" + v; });
  $$(".tabs a").forEach(a => a.removeAttribute("aria-current"));
  const t = $(`.tabs a[data-v="${v}"]`); if (t) { t.setAttribute("aria-current", "page"); t.scrollIntoView({ block: "nearest", inline: "center" }); }
  try { localStorage.setItem("nyc26:vue", v); } catch (e) {}
}
addEventListener("hashchange", () => { route(); scrollTo(0, 0); });
if (!location.hash) { try { const v = localStorage.getItem("nyc26:vue"); if (v && vues.includes(v)) history.replaceState(null, "", "#" + v); } catch (e) {} }
route();

/* ---------------- état partagé (db du site claude.ai) ou local (fichier hors-ligne) */
const S = { resa: {}, bingo: {}, faits: {}, votes: {}, monVote: null, uid: null, db: null, user: null, lecture: false };
const lget = k => { try { return JSON.parse(localStorage.getItem("nyc26:" + k) || "null"); } catch (e) { return null; } };
const lset = (k, v) => { try { localStorage.setItem("nyc26:" + k, JSON.stringify(v)); } catch (e) {} };
for (const k of ["resa", "bingo", "faits"]) S[k] = lget(k) || {};
S.monVote = lget("vote");
D.reservations.forEach(r => { if (r.statut === "fait") S.resa[r.id] = true; });
const files = {};
function ecrire(k) {
  lset(k, S[k]);
  if (!S.db || S.lecture) return;
  const prev = files[k] || Promise.resolve();
  files[k] = prev.then(() => S.db.doc("etat/" + k).set({ ...S[k] })).catch(e => { if (e && e.code === "invalid_argument") { S.lecture = true; syncTxt("Lecture seule"); } });
}
function basculer(k, cle) { const n = { ...S[k] }; if (n[cle]) delete n[cle]; else n[cle] = true; S[k] = n; ecrire(k); rendre(); }
function syncTxt(t) { $$(".sync").forEach(e => e.textContent = t); }
async function brancher() {
  if (!window.claude || !window.claude.use) { syncTxt("Mode hors-ligne : enregistré sur ce téléphone."); return; }
  let db = null, user = null;
  try { [db, user] = await Promise.all([window.claude.use("db"), window.claude.use("user")]); } catch (e) {}
  S.user = user;
  if (!db) { syncTxt("Enregistré sur ce téléphone."); return; }
  S.db = db; S.uid = user ? await user.id() : null;
  syncTxt("Synchronisé avec la famille.");
  const t = setTimeout(() => syncTxt("Synchronisation en attente de connexion…"), 10000);
  for (const k of ["resa", "bingo", "faits"]) {
    db.doc("etat/" + k).onSnapshot(s => {
      if (!s.metadata.fromCache) { clearTimeout(t); syncTxt("Synchronisé avec la famille."); }
      if (s.exists) { S[k] = { ...s.data() }; lset(k, S[k]); rendre(); }
    }, () => {});
  }
  db.collection("votes").onSnapshot(q => {
    S.votes = {}; q.docs.forEach(d => { const c = d.data().choix; if (typeof c === "string") S.votes[d.id] = c; });
    if (S.uid && S.votes[S.uid]) S.monVote = S.votes[S.uid];
    rendreVotes();
  }, () => {});
}

/* ---------------- rendu des cases cochées */
function rendre() {
  $$("[data-fait]").forEach(c => { c.checked = !!S.faits[c.dataset.fait]; const st = c.closest(".station"); if (st) st.classList.toggle("fait", c.checked); });
  $$("[data-resa-case]").forEach(c => { c.checked = !!S.resa[c.dataset.resaCase]; });
  $$("[data-resa]").forEach(e => e.classList.toggle("fait", !!S.resa[e.dataset.resa]));
  rendreBingo(); maintenant();
}
document.addEventListener("change", ev => {
  const c = ev.target;
  if (c.dataset.fait) basculer("faits", c.dataset.fait);
  if (c.dataset.resaCase) basculer("resa", c.dataset.resaCase);
});

/* ---------------- vote du réveillon */
async function rendreVotes() {
  const tous = { ...S.votes }; if (S.monVote && !S.uid) tous["moi"] = S.monVote;
  const ids = Object.keys(tous).filter(i => i !== "moi");
  let ps = {}; if (S.user && ids.length) { try { ps = await S.user.profiles(ids); } catch (e) {} }
  const parChoix = {};
  for (const [id, c] of Object.entries(tous)) (parChoix[c] = parChoix[c] || []).push(id === "moi" || id === S.uid ? "vous" : ((ps[id] && ps[id].name) || "quelqu'un"));
  $$("[data-qui]").forEach(e => { const l = parChoix[e.dataset.qui] || []; e.textContent = l.length ? `${l.length} vote${l.length > 1 ? "s" : ""} : ${l.join(", ")}` : ""; });
  $$("[data-vote]").forEach(b => { const moi = b.dataset.vote === S.monVote; b.classList.toggle("prim", moi); b.textContent = moi ? "Mon choix ✓" : "Je vote pour ça"; });
  const bar = $("#votes"); bar.textContent = "";
  const tri = Object.entries(parChoix).sort((a, b) => b[1].length - a[1].length);
  if (!tri.length) { const s = document.createElement("span"); s.className = "pied"; s.textContent = "Aucun vote pour l'instant. Chacun vote depuis son téléphone."; bar.append(s); return; }
  tri.forEach(([c, l]) => { const ch = D.reveillon.choix.find(x => x.id === c); const s = document.createElement("span"); s.className = "chip"; s.textContent = `${ch ? ch.titre : c} · ${l.length}`; bar.append(s); });
}
document.addEventListener("click", async ev => {
  const b = ev.target.closest("[data-vote]"); if (!b) return;
  S.monVote = b.dataset.vote; lset("vote", S.monVote);
  if (S.db && S.uid) { S.votes[S.uid] = S.monVote; try { await S.db.doc("votes/" + S.uid).set({ choix: S.monVote, le: new Date().toISOString() }); } catch (e) {} }
  rendreVotes();
});

/* ---------------- bingo */
const lignesBingo = []; for (let i = 0; i < 5; i++) { lignesBingo.push([0,1,2,3,4].map(j => i * 5 + j)); lignesBingo.push([0,1,2,3,4].map(j => j * 5 + i)); }
lignesBingo.push([0,6,12,18,24], [4,8,12,16,20]);
function rendreBingo() {
  const ok = new Set(); lignesBingo.forEach(l => { if (l.every(i => S.bingo[i])) l.forEach(i => ok.add(i)); });
  $$("#bingo button").forEach(b => { const i = +b.dataset.b; b.setAttribute("aria-pressed", S.bingo[i] ? "true" : "false"); b.classList.toggle("ligne-ok", ok.has(i)); });
}
$("#bingo").addEventListener("click", ev => { const b = ev.target.closest("button"); if (b) basculer("bingo", b.dataset.b); });

/* ---------------- quiz (score sur ce téléphone) */
let qi = 0, score = 0;
function quiz() {
  const box = $("#quiz"), Q = D.jeux.quiz; box.textContent = "";
  if (qi >= Q.length) {
    const p = document.createElement("p"); p.innerHTML = `<b>Score : ${score} / ${Q.length}</b>`; box.append(p);
    const r = document.createElement("button"); r.className = "btn"; r.textContent = "Recommencer"; r.onclick = () => { qi = 0; score = 0; quiz(); }; box.append(r); return;
  }
  const q = Q[qi], e = document.createElement("div"); e.className = "eyebrow"; e.textContent = `Question ${qi + 1} / ${Q.length} · score ${score}`;
  const t = document.createElement("p"); t.style.fontWeight = "600"; t.textContent = q.q;
  const ch = document.createElement("div"); ch.className = "choix";
  q.choix.forEach((c, i) => { const b = document.createElement("button"); b.className = "btn"; b.textContent = c;
    b.onclick = () => { if (ch.dataset.fini) return; ch.dataset.fini = 1; if (i === q.r) score++; [...ch.children].forEach((x, k) => x.classList.add(k === q.r ? "bon" : (k === i ? "faux" : "")));
      const n = document.createElement("button"); n.className = "btn prim"; n.textContent = "Question suivante →"; n.onclick = () => { qi++; quiz(); }; box.append(n); };
    ch.append(b); });
  box.append(e, t, ch);
}
quiz();

/* ---------------- carte : filtre par jour */
$("#filtre-jours").addEventListener("click", ev => {
  const b = ev.target.closest("button"); if (!b) return;
  $$("#filtre-jours button").forEach(x => x.classList.toggle("prim", x === b));
  $$(".carte-ensemble [data-jour]").forEach(el => el.style.opacity = !b.dataset.j || el.dataset.jour === b.dataset.j ? "" : ".12");
});

/* ---------------- « Maintenant » : heure de New York */
function heureNY() {
  const p = Object.fromEntries(new Intl.DateTimeFormat("en-CA", { timeZone: "America/New_York", year: "numeric", month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit", hourCycle: "h23" }).formatToParts(new Date()).map(x => [x.type, x.value]));
  return { iso: `${p.year}-${p.month}-${p.day}`, min: (+p.hour) * 60 + (+p.minute) };
}
function quand() {
  const j = $("#simu-jour").value;
  if (j) { const [h, m] = ($("#simu-heure").value || "14:00").split(":").map(Number); return { iso: j, min: h * 60 + m, simu: true }; }
  return heureNY();
}
const lien = (href, txt, prim) => { const a = document.createElement("a"); a.className = "btn" + (prim ? " prim" : ""); a.href = href; a.textContent = txt; if (/^https:/.test(href)) { a.target = "_blank"; a.rel = "noopener"; } return a; };
function maintenant() {
  const n = quand(), big = $("#m-big"), txt = $("#m-txt"), btns = $("#m-btns"), carte = big.closest(".card");
  const ny = heureNY(); $("#hl-ny").textContent = `New York : ${hm(ny.min)}`;
  $$(".station").forEach(s => s.classList.remove("maint-ici"));
  btns.textContent = "";
  const premier = D.jours[0].iso, dernier = D.jours[D.jours.length - 1].iso;
  if (n.iso < premier) {
    const jours = Math.round((Date.parse(premier) - Date.parse(n.iso)) / 864e5);
    big.textContent = `J-${jours}`;
    const reste = D.reservations.filter(r => !S.resa[r.id]);
    const urg = reste.filter(r => r.urgence === 1).length;
    txt.textContent = `Atterrissage à JFK le dimanche 27 décembre à 20h. ${reste.length} réservation${reste.length > 1 ? "s" : ""} à faire, dont ${urg} urgente${urg > 1 ? "s" : ""}.`;
    btns.append(lien("#resa", "Voir les réservations", true), lien("#j28", "Premier jour"));
    carte.style.setProperty("--c", "var(--red)"); return;
  }
  if (n.iso > dernier) { big.textContent = "Bon retour !"; txt.textContent = "Le voyage est terminé. Les cases cochées et le bingo restent en souvenir."; return; }
  const jour = D.jours.find(j => j.iso === n.iso);
  if (!jour) return;
  carte.style.setProperty("--c", jour.couleur);
  const et = jour.etapes.filter(e => e.duree > 0 || e.id_lieu === "hotel");
  const cur = et.find(e => e.debut_min <= n.min && n.min < e.fin_min);
  const next = et.find(e => e.debut_min > n.min);
  if (cur) { const st = $(`.station[data-key="${cur.key}"]`); if (st) st.classList.add("maint-ici"); }
  if (cur) {
    big.textContent = cur.titre;
    txt.textContent = `Jusqu'à ${cur.fin}${next ? ` · ensuite ${next.debut} : ${next.titre}` : ""}${next && next.trajet ? ` (partir vers ${hm(next.debut_min - next.trajet.duree_totale - (next.attente || 0))}, ${next.trajet.duree_totale} min de trajet)` : ""}.`;
  } else if (next) {
    const partir = next.trajet ? next.debut_min - (next.attente || 0) - next.trajet.duree_totale : next.debut_min;
    big.textContent = `${next.debut} · ${next.titre}`;
    txt.textContent = next.trajet ? `Partir à ${hm(partir)} : ${next.trajet.de ? next.trajet.de + " → " + next.trajet.a : "à pied"} (${next.trajet.duree_totale} min).` : "Prochaine étape.";
  } else { big.textContent = "Fin de journée"; txt.textContent = "Bonne nuit !"; }
  const cible = next || cur;
  if (cible) btns.append(lien(cible.gmaps, "Itinéraire vers la prochaine étape ↗", true));
  btns.append(lien("#j" + jour.iso.slice(8), "Programme du jour"));
}
$("#simu-jour").addEventListener("change", maintenant); $("#simu-heure").addEventListener("input", maintenant);
setInterval(maintenant, 30000);

rendre(); rendreVotes(); brancher();
})();
</script>

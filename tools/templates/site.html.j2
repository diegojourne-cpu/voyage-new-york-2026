{% if autonome %}<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
{% endif %}
<title>New York Noël 2026</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,500..900&family=Instrument+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap">
<style>
/* Concept : la signalétique du métro new-yorkais. Bandeau noir, pastilles de lignes,
   chaque journée = une ligne de métro dont les étapes sont les stations. */
:root{
  --bg:#f2f3ef; --surface:#ffffff; --surface2:#f7f8f5; --ink:#15191d; --muted:#5b646d; --line:#d8ddd7;
  --sign:#121417; --sign-ink:#f4f4f0; --sign-muted:#a3a9ae;
  --red:#c8102e; --gold:#9a6b12; --green:#0f6b45; --warn:#a15c07; --warn-bg:#fdf3e1; --err:#b91c1c; --err-bg:#fde8e8; --ok:#15803d; --ok-bg:#e5f5ea; --info-bg:#e9eef6;
  --map-eau:#cddfe9; --map-terre:#fbfbf8; --map-terre2:#e9ece6; --map-cote:#b5c3c9; --map-parc:#cfe4cc; --map-marche:#59636c; --map-hotel:#15191d; --map-lbl:#7d8a92;
  --f-display:"Archivo","Arial Narrow","Helvetica Neue",Arial,sans-serif;
  --f-body:"Instrument Sans",system-ui,-apple-system,"Segoe UI",sans-serif;
  --f-mono:"JetBrains Mono",ui-monospace,"SF Mono",Menlo,monospace;
  --r:10px;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#0c0f13; --surface:#151a20; --surface2:#11161b; --ink:#eceee9; --muted:#9aa3ac; --line:#27313b;
  --sign:#000000; --sign-ink:#f4f4f0; --sign-muted:#8d949a;
  --red:#ff5a6b; --gold:#e5b65a; --green:#52c08d; --warn:#f5a524; --warn-bg:#2d2310; --err:#f87171; --err-bg:#2e1416; --ok:#4ade80; --ok-bg:#11281a; --info-bg:#16202c;
  --map-eau:#0c1b27; --map-terre:#1a2129; --map-terre2:#141a20; --map-cote:#2e3c48; --map-parc:#16301f; --map-marche:#9aa3ac; --map-hotel:#eceee9; --map-lbl:#6b7a85;
  color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0c0f13; --surface:#151a20; --surface2:#11161b; --ink:#eceee9; --muted:#9aa3ac; --line:#27313b;
  --sign:#000000; --sign-ink:#f4f4f0; --sign-muted:#8d949a;
  --red:#ff5a6b; --gold:#e5b65a; --green:#52c08d; --warn:#f5a524; --warn-bg:#2d2310; --err:#f87171; --err-bg:#2e1416; --ok:#4ade80; --ok-bg:#11281a; --info-bg:#16202c;
  --map-eau:#0c1b27; --map-terre:#1a2129; --map-terre2:#141a20; --map-cote:#2e3c48; --map-parc:#16301f; --map-marche:#9aa3ac; --map-hotel:#eceee9; --map-lbl:#6b7a85;
  color-scheme:dark}
*{box-sizing:border-box}
[hidden]{display:none!important}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 var(--f-body)}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--sign)}
a{color:inherit}
.wrap{max-width:980px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
h1,h2,h3{font-family:var(--f-display);text-wrap:balance;margin:0}
.mono,time{font-family:var(--f-mono);font-variant-numeric:tabular-nums}
/* ------------ bandeau de signalétique */
.sign{background:var(--sign);color:var(--sign-ink)}
.sign .wrap{padding-block:18px 14px;display:grid;gap:10px}
.sign h1{font-weight:800;font-stretch:72%;font-size:clamp(30px,7vw,46px);line-height:.95;letter-spacing:-.01em}
.sign h1 span{color:var(--sign-muted);font-weight:600}
.sign .sub{color:var(--sign-muted);font-size:13.5px;letter-spacing:.02em}
.horloge{display:flex;flex-wrap:wrap;gap:8px 18px;align-items:baseline;font-family:var(--f-mono);font-size:13px;color:var(--sign-muted)}
.horloge b{color:#ffd34d;font-weight:700}
.tabs{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--sign);border-top:1px solid #2a2e33}
.tabs .wrap{display:flex;gap:6px;overflow-x:auto;padding-block:8px;scrollbar-width:none}
.tabs .wrap::-webkit-scrollbar{display:none}
.tabs a{flex:0 0 auto;text-decoration:none;color:var(--sign-ink);font:600 13px/1 var(--f-body);padding:9px 12px;border-radius:999px;border:1px solid #33383e;white-space:nowrap;display:inline-flex;gap:7px;align-items:center}
.tabs a[aria-current="page"]{background:var(--sign-ink);color:var(--sign);border-color:var(--sign-ink)}
.tabs a:focus-visible,button:focus-visible,summary:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #ffd34d;outline-offset:2px}
.puce{width:10px;height:10px;border-radius:50%;display:inline-block;flex:none}
main{padding-block:22px 64px}
.vue{display:grid;gap:22px}
.vue>header{display:grid;gap:6px}
.eyebrow{font:700 11.5px/1 var(--f-body);letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.vue h2{font-size:clamp(24px,5vw,34px);font-weight:800;font-stretch:80%;line-height:1.05}
.lead{color:var(--muted);max-width:65ch;margin:0}
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:16px}
.grid2{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr))}
.chip{display:inline-flex;align-items:center;gap:5px;font:600 11.5px/1 var(--f-body);padding:5px 8px;border-radius:999px;border:1px solid var(--line);color:var(--muted);background:var(--surface2);white-space:nowrap}
.chip.abs{background:var(--red);border-color:var(--red);color:#fff}
.chip.plus{border-color:var(--gold);color:var(--gold)}
.chip.resa{border-color:var(--ink);color:var(--ink)}
.chip.pass{border-color:var(--green);color:var(--green)}
.chip.verif{background:var(--warn-bg);border-color:transparent;color:var(--warn)}
.chip.noel{border-color:var(--red);color:var(--red)}
.bullet{display:inline-grid;place-items:center;min-width:22px;height:22px;padding:0 5px;border-radius:11px;font:800 12.5px/1 var(--f-body);color:#fff}
.bullet.noir{color:#111}
.bullet.sq{border-radius:4px;font-size:10px;letter-spacing:.04em}
/* ------------ semaine (accueil) */
.semaine{display:grid;gap:10px;grid-template-columns:repeat(auto-fit,minmax(min(100%,170px),1fr))}
.jcard{display:grid;gap:6px;text-decoration:none;background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:14px;border-top:6px solid var(--c)}
.jcard .d{font:700 12px/1 var(--f-body);letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.jcard h3{font-size:19px;font-stretch:85%;font-weight:800;line-height:1.1}
.jcard p{margin:0;font-size:13px;color:var(--muted)}
.maint{display:grid;gap:12px}
.maint .big{font:800 clamp(40px,10vw,64px)/1 var(--f-display);font-stretch:70%}
.prochain{border-left:6px solid var(--c,var(--red))}
.prochain .t{font:700 22px/1.1 var(--f-display);font-stretch:85%}
.btns{display:flex;flex-wrap:wrap;gap:8px}
.btn{display:inline-flex;align-items:center;gap:6px;font:600 13.5px/1 var(--f-body);padding:10px 14px;border-radius:8px;border:1px solid var(--line);background:var(--surface);color:var(--ink);text-decoration:none;cursor:pointer}
.btn.prim{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.simu{display:flex;flex-wrap:wrap;gap:8px;align-items:center;font-size:13px;color:var(--muted)}
.simu select,.simu input{font:inherit;padding:7px 8px;border-radius:7px;border:1px solid var(--line);background:var(--surface);color:var(--ink)}
/* ------------ journée = ligne de métro */
.jour-tete{display:grid;gap:10px;border-radius:var(--r);overflow:hidden;background:var(--sign);color:var(--sign-ink)}
.jour-tete .haut{display:flex;gap:14px;align-items:center;padding:16px 16px 0}
.jour-tete .rond{width:46px;height:46px;border-radius:50%;background:var(--c);display:grid;place-items:center;font:800 18px/1 var(--f-display);color:#fff;flex:none}
.jour-tete h2{color:var(--sign-ink)}
.jour-tete .meta{display:flex;flex-wrap:wrap;gap:6px 16px;padding:0 16px 14px;font-family:var(--f-mono);font-size:12.5px;color:var(--sign-muted)}
.jour-tete .meta b{color:var(--sign-ink);font-weight:700}
.carte{display:block;width:100%;height:auto;aspect-ratio:1.25;background:var(--map-eau);border-radius:var(--r);border:1px solid var(--line)}
.carte-ensemble{aspect-ratio:.95}
.map-lbl text{font-family:var(--f-display);font-weight:800;letter-spacing:.2em;fill:var(--map-lbl);font-size:48px}
.map-lbl text.eau{font-style:italic;letter-spacing:.05em;font-weight:600;font-size:34px}
.ligne{list-style:none;margin:0;padding:0;position:relative;display:grid}
.ligne::before{content:"";position:absolute;left:21px;top:24px;bottom:24px;width:8px;border-radius:4px;background:var(--c)}
.station{position:relative;display:grid;grid-template-columns:50px minmax(0,1fr);gap:0 12px;padding-block:6px}
.station .pt{width:30px;height:30px;margin:4px 0 0 10px;border-radius:50%;background:var(--surface);border:6px solid var(--c);z-index:1;display:grid;place-items:center;font:800 11px/1 var(--f-body);color:var(--ink)}
.station.fait .pt{background:var(--c)}
.station.maint-ici .pt{box-shadow:0 0 0 5px color-mix(in srgb,var(--c) 35%,transparent)}
.station .corps{min-width:0;background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:12px 14px;display:grid;gap:8px}
.station.repas .corps{background:var(--surface2)}
.station .entete{display:flex;gap:10px;align-items:baseline;flex-wrap:wrap}
.station .heure{font:700 17px/1 var(--f-mono);font-variant-numeric:tabular-nums}
.station .heure small{font-size:12px;color:var(--muted);font-weight:500}
.station h3{font-size:18px;font-weight:800;font-stretch:85%;line-height:1.15}
.station .q{font-size:12.5px;color:var(--muted)}
.station .chips{display:flex;flex-wrap:wrap;gap:5px}
.station .quoi{margin:0}
.trajet{position:relative;display:grid;grid-template-columns:50px minmax(0,1fr);gap:0 12px;padding-block:2px}
.trajet .tx{grid-column:2;display:flex;flex-wrap:wrap;gap:6px;align-items:center;font-size:12.5px;color:var(--muted);padding:4px 2px}
.trajet .tx .du{font-family:var(--f-mono);color:var(--ink);font-weight:700}
details.plus{border-top:1px dashed var(--line);padding-top:6px}
details.plus summary{cursor:pointer;font:600 13px/1.4 var(--f-body);color:var(--muted);list-style:none;display:flex;gap:6px;align-items:center}
details.plus summary::-webkit-details-marker{display:none}
details.plus summary::before{content:"＋";font-weight:800}
details.plus[open] summary::before{content:"－"}
dl.kv{display:grid;grid-template-columns:minmax(90px,auto) minmax(0,1fr);gap:6px 12px;margin:8px 0 0;font-size:13.5px}
dl.kv dt{color:var(--muted);font-weight:600}
dl.kv dd{margin:0}
.case{display:inline-flex;gap:8px;align-items:center;font-size:13px;font-weight:600;cursor:pointer;user-select:none}
.case input{width:18px;height:18px;accent-color:var(--ok)}
.alerte{display:grid;grid-template-columns:auto minmax(0,1fr);gap:8px;padding:9px 12px;border-radius:8px;font-size:13.5px}
.alerte.erreur{background:var(--err-bg);color:var(--err)}
.alerte.attention{background:var(--warn-bg);color:var(--warn)}
.alerte.info{background:var(--info-bg);color:var(--muted)}
.liste-alertes{display:grid;gap:6px}
/* ------------ tableaux */
.tbl{overflow-x:auto;border:1px solid var(--line);border-radius:var(--r);background:var(--surface)}
table{border-collapse:collapse;width:100%;font-size:13.5px}
th,td{text-align:left;padding:9px 12px;border-bottom:1px solid var(--line);vertical-align:top}
th{font:700 11.5px/1.2 var(--f-body);letter-spacing:.08em;text-transform:uppercase;color:var(--muted);background:var(--surface2)}
td.num,th.num{text-align:right;font-family:var(--f-mono);font-variant-numeric:tabular-nums;white-space:nowrap}
tr.best td{background:var(--ok-bg)}
/* ------------ réservations */
.resa{display:grid;grid-template-columns:auto minmax(0,1fr);gap:12px;align-items:start}
.resa .u{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;font:800 13px/1 var(--f-body);color:#fff}
.resa.u1 .u{background:var(--red)} .resa.u2 .u{background:var(--warn)} .resa.u3 .u{background:var(--muted)}
.resa.fait{opacity:.55}
.resa.fait h3{text-decoration:line-through}
.resa h3{font-size:16.5px;font-stretch:90%;font-weight:800}
/* ------------ réveillon */
.nye{display:grid;gap:10px}
.nye .note{font-family:var(--f-mono);color:var(--gold);letter-spacing:.1em}
.nye.reco{border:2px solid var(--gold)}
.votebar{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.votes-qui{font-size:12.5px;color:var(--muted)}
/* ------------ jeux */
.bingo{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:6px}
.bingo button{aspect-ratio:1;border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:8px;font:600 clamp(9.5px,2.4vw,12.5px)/1.2 var(--f-body);padding:4px;cursor:pointer;display:grid;place-items:center;text-align:center;overflow-wrap:anywhere}
.bingo button[aria-pressed="true"]{background:var(--red);border-color:var(--red);color:#fff}
.bingo button.ligne-ok[aria-pressed="true"]{background:var(--green);border-color:var(--green)}
.quiz .choix{display:grid;gap:8px}
.quiz .choix button{text-align:left}
.quiz .choix button.bon{background:var(--ok-bg);border-color:var(--ok);color:var(--ok)}
.quiz .choix button.faux{background:var(--err-bg);border-color:var(--err);color:var(--err)}
.legende{display:flex;flex-wrap:wrap;gap:8px 14px;font-size:12.5px;color:var(--muted)}
.legende span{display:inline-flex;gap:6px;align-items:center}
.pied{font-size:12.5px;color:var(--muted)}
.sync{font-size:12px;color:var(--muted)}
@media (prefers-reduced-motion:no-preference){.station .pt{transition:background .2s}}
@media (max-width:520px){.station,.trajet{grid-template-columns:40px minmax(0,1fr);gap:0 8px}.ligne::before{left:16px;width:7px}.station .pt{margin-left:6px;width:28px;height:28px;border-width:5px}}
</style>
{% if autonome %}</head><body>{% endif %}
{{ fond|safe }}
<header class="sign">
  <div class="wrap">
    <h1>New York <span>·</span> Noël 2026</h1>
    <div class="sub">{{ ctx.voyage.sous_titre }}</div>
    <div class="horloge" id="horloge"><span>Hôtel · 330 W 40th St</span><span>Coucher du soleil ≈ <b>16:36</b></span><span id="hl-ny"></span></div>
  </div>
</header>
<nav class="tabs" aria-label="Sections">
  <div class="wrap">
    <a href="#maintenant" data-v="maintenant">Maintenant</a>
    {% for j in ctx.jours %}<a href="#j{{ j.iso[8:] }}" data-v="j{{ j.iso[8:] }}"><span class="puce" style="background:{{ j.couleur }}"></span>{{ j.label_court.split(' ')[0] }} {{ j.label.split(' ')[0][:3] }}.</a>
    {% endfor %}<a href="#carte" data-v="carte">Carte</a>
    <a href="#resa" data-v="resa">Réservations</a>
    <a href="#reveillon" data-v="reveillon">Réveillon</a>
    <a href="#pass" data-v="pass">Pass &amp; budget</a>
    <a href="#options" data-v="options">Options</a>
    <a href="#jeux" data-v="jeux">Jeux</a>
    <a href="#infos" data-v="infos">Infos</a>
  </div>
</nav>
<main class="wrap">

<!-- ================================================================ MAINTENANT -->
<section class="vue" id="v-maintenant">
  <div class="maint" id="maint">
    <div class="card prochain">
      <div class="eyebrow">Compte à rebours</div>
      <div class="big mono" id="m-big">J-{{ ctx.j_moins }}</div>
      <p class="lead" id="m-txt">Atterrissage à JFK le dimanche 27 décembre à 20h. Tout est prêt sauf les réservations ci-dessous.</p>
      <div class="btns" id="m-btns"></div>
    </div>
  </div>
  <div class="simu" aria-label="Aperçu à un autre moment">
    <span>Aperçu à un autre moment :</span>
    <select id="simu-jour"><option value="">maintenant</option>{% for j in ctx.jours %}<option value="{{ j.iso }}">{{ j.label }}</option>{% endfor %}</select>
    <input id="simu-heure" type="time" value="14:00" aria-label="Heure simulée">
  </div>
  <header><div class="eyebrow">La semaine</div><h2>Cinq jours de magie de Noël</h2></header>
  <div class="semaine">
    {% for j in ctx.jours %}
    <a class="jcard" href="#j{{ j.iso[8:] }}" style="--c:{{ j.couleur }}">
      <span class="d">{{ j.label }}</span>
      <h3>{{ j.titre }}</h3>
      <p>{{ j.theme }}</p>
    </a>
    {% endfor %}
  </div>
  <header><div class="eyebrow">À faire en premier</div><h2>Réservations urgentes</h2></header>
  <div class="grid2" id="urgentes">
    {% for r in ctx.reservations if r.urgence == 1 %}
    <div class="card resa u1" data-resa="{{ r.id }}"><span class="u">1</span><div><h3>{{ r.titre }}</h3><div class="q pied">{{ r.creneau }}</div><a class="btn" href="{{ r.lien }}" target="_blank" rel="noopener">Réserver ↗</a></div></div>
    {% endfor %}
  </div>
</section>

<!-- ================================================================ JOURS -->
{% for j in ctx.jours %}
<section class="vue" id="v-j{{ j.iso[8:] }}" style="--c:{{ j.couleur }}" hidden>
  <div class="jour-tete">
    <div class="haut"><div class="rond">{{ j.iso[8:]|int }}</div><div><div class="eyebrow" style="color:var(--sign-muted)">{{ j.label }}</div><h2>{{ j.titre }}</h2></div></div>
    <div class="meta"><span>Départ <b>{{ j.depart }}</b></span><span>Coucher du soleil <b>{{ j.soleil.coucher }}</b></span><span>Nuit noire <b>{{ j.soleil.nuit }}</b></span>{% if j.etapes %}<span>Fin <b>{{ j.etapes[-1].debut }}</b></span>{% endif %}</div>
  </div>
  {% if j.note %}<p class="lead">{{ j.note }}</p>{% endif %}
  {{ j.svg|safe }}
  <div class="legende"><span><span class="bullet sq" style="background:var(--map-hotel);color:var(--map-terre)">H</span>hôtel</span><span><span class="puce" style="background:{{ j.couleur }}"></span>étapes et balades</span><span>┈ marche</span><span>━ métro (couleur de la ligne)</span><span style="color:#00a3e0">╍ ferry</span><span style="color:#e0a800">┄ taxi</span></div>
  {% if j.alertes %}<div class="liste-alertes">{% for a in j.alertes if a.niveau != 'info' %}<div class="alerte {{ a.niveau }}"><span>{{ '❌' if a.niveau=='erreur' else '⚠️' }}</span><span><b>{{ a.etape }}</b> — {{ a.message }}</span></div>{% endfor %}</div>{% endif %}
  <ol class="ligne">
  {% for e in j.etapes %}
    {% if e.trajet %}
    <li class="trajet"><div class="tx">
      <span aria-hidden="true">{{ e.trajet.icone }}</span>
      {% for l in e.trajet.lignes %}<span class="bullet{{ ' noir' if l in NOIR }}{{ ' sq' if l|length > 1 }}" style="background:{{ COULEURS.get(l, '#808183') }}">{{ 'MN' if l=='MNR' else ('⛴' if l=='FERRY' else l) }}</span>{% endfor %}
      <span>{% if e.trajet.de %}{{ e.trajet.de }} → {{ e.trajet.a }}{% elif e.trajet.mode == 'marche' %}à pied{% if e.trajet.km %} · {{ e.trajet.km }} km{% endif %}{% else %}{{ e.trajet.mode }}{% endif %}</span>
      <span class="du">{{ e.trajet.duree_totale }} min</span>
      {% if e.attente > 0 %}<span>· {{ e.attente }} min d'avance</span>{% endif %}
    </div></li>
    {% endif %}
    <li class="station{{ ' repas' if e.repas }}" data-key="{{ e.key }}" data-debut="{{ e.debut_min }}" data-fin="{{ e.fin_min }}">
      <div class="pt">{{ e.n if e.n else 'H' }}</div>
      <div class="corps">
        <div class="entete"><span class="heure">{{ e.debut }}{% if e.duree %}<small> → {{ e.fin }}</small>{% endif %}</span>{% if e.creneau %}<span class="chip resa">créneau {{ e.creneau }}</span>{% endif %}</div>
        <div><h3>{{ e.titre }}</h3><div class="q">{{ e.quartier }}{% if e.duree %} · {{ e.duree }} min sur place{% endif %}</div></div>
        <div class="chips">
          {% if e.priorite == 'absolument' %}<span class="chip abs">Absolument</span>{% elif e.priorite == 'plus' %}<span class="chip plus">＋ Envie forte</span>{% endif %}
          {% if e.noel %}<span class="chip noel">✶ Noël</span>{% endif %}
          {% if e.reservation == 'obligatoire' %}<span class="chip resa">Réservation</span>{% endif %}
          {% if 'citypass' in e.pass %}<span class="chip pass">CityPASS</span>{% elif 'call' in e.pass %}<span class="chip pass">C-All</span>{% endif %}
          {% if e.fiabilite == 'a_verifier' %}<span class="chip verif">Horaires à confirmer</span>{% endif %}
          {% if e.prix %}<span class="chip">{{ e.prix|usd }}</span>{% endif %}
        </div>
        {% if e.quoi %}<p class="quoi">{{ e.quoi }}</p>{% endif %}
        {% if e.id_lieu != 'hotel' or e.duree %}
        <details class="plus"><summary>Détails, astuce photo, anecdote</summary>
          <dl class="kv">
            {% if e.trajet %}<dt>Trajet</dt><dd>{{ e.trajet.detail or ('À pied' if e.trajet.mode=='marche' else '') }}{% if e.trajet.prix %} — {{ e.trajet.prix|usd }}/pers.{% endif %}</dd>{% endif %}
            {% if e.adresse %}<dt>Adresse</dt><dd>{{ e.adresse }}</dd>{% endif %}
            <dt>Horaires</dt><dd>{{ e.horaires_jour }}{% if e.note_horaires %}<br><span class="pied">{{ e.note_horaires }}</span>{% endif %}</dd>
            {% if e.prix or e.prix_note %}<dt>Prix</dt><dd>{{ e.prix|usd if e.prix else 'Gratuit' }}{% if e.prix_note %} — {{ e.prix_note }}{% endif %}</dd>{% endif %}
            {% if e.conseil %}<dt>Conseil</dt><dd>{{ e.conseil }}</dd>{% endif %}
            {% if e.heure_creuse %}<dt>Éviter la foule</dt><dd>{{ e.heure_creuse }}</dd>{% endif %}
            {% if e.astuce_photo %}<dt>Photo</dt><dd>{{ e.astuce_photo }}</dd>{% endif %}
            {% if e.anecdote %}<dt>Anecdote</dt><dd>{{ e.anecdote }}</dd>{% endif %}
            {% if e.boutiques %}<dt>Adresses</dt><dd>{% for b in e.boutiques %}{{ b }}{% if not loop.last %}<br>{% endif %}{% endfor %}</dd>{% endif %}
            {% if e.noel %}<dt>Noël</dt><dd>{{ e.noel }}</dd>{% endif %}
          </dl>
          <div class="btns" style="margin-top:10px"><a class="btn" href="{{ e.gmaps }}" target="_blank" rel="noopener">Itinéraire ↗</a>{% if e.lien %}<a class="btn" href="{{ e.lien }}" target="_blank" rel="noopener">Site officiel ↗</a>{% endif %}</div>
        </details>
        {% endif %}
        {% if e.id_lieu not in ('hotel','jfk') %}<label class="case"><input type="checkbox" data-fait="{{ e.key }}"> Fait</label>{% endif %}
      </div>
    </li>
  {% endfor %}
  </ol>
  {% if ctx.jeux.defis_photo.get(j.iso) %}
  <div class="card"><div class="eyebrow">Défis photo du jour</div>
    <div style="display:grid;gap:6px;margin-top:8px">{% for d in ctx.jeux.defis_photo[j.iso] %}<label class="case"><input type="checkbox" data-fait="defi-{{ j.iso }}-{{ loop.index }}"> {{ d }}</label>{% endfor %}</div>
  </div>
  {% endif %}
</section>
{% endfor %}

<!-- ================================================================ CARTE -->
<section class="vue" id="v-carte" hidden>
  <header><div class="eyebrow">Vue d'ensemble</div><h2>Tous les parcours</h2><p class="lead">Une couleur par jour. Touchez un jour pour l'isoler. La carte fonctionne sans connexion ; pour la navigation pas à pas, utilisez les boutons « Itinéraire » de chaque étape ou importez <span class="mono">voyage.kml</span> dans Google My Maps.</p></header>
  <div class="btns" id="filtre-jours"><button class="btn prim" data-j="">Tous</button>{% for j in ctx.jours if j.iso != '2026-12-27' %}<button class="btn" data-j="{{ j.iso }}"><span class="puce" style="background:{{ j.couleur }}"></span>{{ j.label_court }}</button>{% endfor %}</div>
  {{ ensemble|safe }}
</section>

<!-- ================================================================ RÉSERVATIONS -->
<section class="vue" id="v-resa" hidden>
  <header><div class="eyebrow">Par ordre d'urgence</div><h2>Réservations</h2><p class="lead">Cochez quand c'est fait : la case se met à jour sur les trois téléphones. <span class="sync" id="sync-resa"></span></p></header>
  <div style="display:grid;gap:10px">
  {% for r in ctx.reservations %}
    <div class="card resa u{{ r.urgence }}" data-resa="{{ r.id }}">
      <span class="u">{{ r.urgence }}</span>
      <div style="display:grid;gap:6px;min-width:0">
        <h3>{{ r.titre }}</h3>
        <dl class="kv" style="margin:0"><dt>Quand</dt><dd>{{ r.quand }}</dd><dt>Créneau</dt><dd>{{ r.creneau }}</dd><dt>Prix</dt><dd>{{ r.prix }}</dd>{% if r.detail %}<dt>Détail</dt><dd>{{ r.detail }}</dd>{% endif %}</dl>
        <div class="btns"><a class="btn" href="{{ r.lien }}" target="_blank" rel="noopener">Lien officiel ↗</a><label class="case"><input type="checkbox" data-resa-case="{{ r.id }}"{{ ' checked' if r.statut == 'fait' }}> Fait</label></div>
      </div>
    </div>
  {% endfor %}
  </div>
</section>

<!-- ================================================================ RÉVEILLON -->
<section class="vue" id="v-reveillon" hidden>
  <header><div class="eyebrow">Jeudi 31 décembre</div><h2>Où passer minuit ?</h2><p class="lead">{{ ctx.reveillon.intro }}</p></header>
  <div class="card" style="border-left:6px solid var(--gold)"><div class="eyebrow">Notre conseil</div><p style="margin:.4em 0 0">{{ ctx.reveillon.recommandation }}</p></div>
  <div class="card"><div class="eyebrow">Vote de la famille</div><div class="votebar" id="votes" style="margin-top:8px"><span class="pied">Choisissez votre option préférée ci-dessous.</span></div></div>
  <div style="display:grid;gap:12px">
  {% for c in ctx.reveillon.choix %}
    <article class="card nye{{ ' reco' if loop.first }}" data-choix="{{ c.id }}">
      <div class="entete" style="display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap"><h3 style="font-size:19px;font-stretch:85%">{{ c.titre }}</h3><span class="note" aria-label="Note {{ c.note }} sur 5">{{ '★' * c.note }}{{ '☆' * (5 - c.note) }}</span></div>
      <dl class="kv" style="margin:0"><dt>Arrivée</dt><dd>{{ c.arrivee }}</dd><dt>Foule</dt><dd>{{ c.foule }}</dd><dt>Attente</dt><dd>{{ c.attente }}</dd><dt>Froid</dt><dd>{{ c.froid }}</dd><dt>Coût</dt><dd>{{ c.cout }}</dd><dt>Accès et retour</dt><dd>{{ c.acces_retour }}</dd><dt>Pour</dt><dd>{{ c.plus|join(' · ') }}</dd><dt>Contre</dt><dd>{{ c.moins|join(' · ') }}</dd></dl>
      <div class="btns"><button class="btn" data-vote="{{ c.id }}">Je vote pour ça</button><span class="votes-qui" data-qui="{{ c.id }}"></span></div>
    </article>
  {% endfor %}
  </div>
</section>

<!-- ================================================================ PASS & BUDGET -->
<section class="vue" id="v-pass" hidden>
  {% set best = ctx.pass.scenarios|selectattr('code','equalto',ctx.pass.meilleur)|first %}
  <header><div class="eyebrow">Calculé à partir du programme</div><h2>Pass : {{ best.nom }}</h2><p class="lead">Avec notre programme, le {{ best.nom }} revient à <b>{{ best.total_eur_3|eur }}</b> pour vous trois (pass + entrées à payer à part), contre {{ (ctx.pass.scenarios|selectattr('code','equalto','aucun')|first).total_eur_3|eur }} sans pass et {{ (ctx.pass.scenarios|selectattr('code','equalto','call')|first).total_eur_3|eur }} avec le C-All.</p></header>
  <div class="tbl"><table>
    <thead><tr><th>Option</th><th class="num">Pass / pers.</th><th>Couvre dans notre programme</th><th class="num">Total / pers.</th><th class="num">Total × 3</th></tr></thead>
    <tbody>{% for s in ctx.pass.scenarios %}<tr class="{{ 'best' if s.code == ctx.pass.meilleur }}"><td><b>{{ s.nom }}</b></td><td class="num">{{ s.cout_pass_eur|eur2 }}</td><td>{% for c in s.couvre %}{{ c.nom.split(' (')[0].split(' —')[0] }}{% if not loop.last %}, {% endif %}{% else %}—{% endfor %}{% if s.bonus %}<br><span class="pied">+ inclus sans être au programme : {% for b in s.bonus %}{{ b.nom.split(' (')[0] }}{% if not loop.last %}, {% endif %}{% endfor %}</span>{% endif %}</td><td class="num">{{ s.total_eur_pp|eur2 }}</td><td class="num"><b>{{ s.total_eur_3|eur }}</b></td></tr>{% endfor %}</tbody>
  </table></div>
  <div class="grid2">
    <div class="card"><div class="eyebrow">Pourquoi le CityPASS</div><ul style="margin:.5em 0 0;padding-left:1.1em;display:grid;gap:6px">
      <li>Depuis septembre 2026, c'est 5 attractions <b>au choix</b> parmi 10. Notre programme en utilise 4 (Top of the Rock au coucher du soleil, Empire State de nuit, Natural History, 9/11 Museum). La 5e : <b>Statue de la Liberté</b> si vous prenez l'option, sinon <b>Edge</b> (le 1er janvier, au bout de la High Line).</li>
      <li>Le C-All ajoute surtout le MoMA (30 $) et des attractions que nous n'avons pas le temps de caser (Intrepid, Circle Line, Guggenheim, Whitney). Pour 11 attractions en 5 jours, il faudrait sacrifier les balades et les lumières de Noël.</li>
      <li>Non couverts par les deux pass : MET, MoMA (sauf C-All), MAD, Botanical Garden, patinoire.</li>
    </ul></div>
    <div class="card"><div class="eyebrow">Conditions des pass</div>{% for code, o in ctx.pass.offres.items() %}<p style="margin:.5em 0 .2em"><b>{{ o.nom }}</b> — {{ o.prix_eur|eur2 }} + {{ o.frais_eur|eur2 }} de frais</p><ul style="margin:0;padding-left:1.1em;font-size:13.5px">{% for c in o.conditions %}<li>{{ c }}</li>{% endfor %}</ul>{% endfor %}</div>
  </div>
  <header><div class="eyebrow">Par personne</div><h2>Budget estimé</h2></header>
  <div class="tbl"><table>
    <thead><tr><th>Poste</th><th class="num">USD</th><th>Détail</th></tr></thead>
    <tbody>
      <tr><td>Métro (OMNY)</td><td class="num">{{ ctx.budget.metro|usd }}</td><td>Plafond de 35 $ par carte sur 7 jours, atteint avec notre programme</td></tr>
      <tr><td>Train, ferry</td><td class="num">{{ ctx.budget.autres_transports|usd }}</td><td>Metro-North 5,25 $, NYC Ferry 5 $ (Staten Island gratuit). Taxis : ≈ 33 $ par trajet et par personne</td></tr>
      <tr><td>Taxis JFK (aller + retour)</td><td class="num">{{ ctx.budget.taxis|usd }}</td><td>≈ 100 $ par trajet, divisés par 3</td></tr>
      {% for l in ctx.pass.lignes %}<tr><td>{{ l.nom.split(' (')[0] }}</td><td class="num">{{ l.prix|usd }}</td><td>{% if 'citypass' in l.pass %}<span class="chip pass">CityPASS</span> {% endif %}{{ l.note }}</td></tr>{% endfor %}
      <tr><td>Repas (5 jours)</td><td class="num">{{ ctx.budget.repas_estimation.bas }}–{{ ctx.budget.repas_estimation.haut }} $</td><td>Estimation : 60 à 110 $/jour, taxe et pourboire compris (hors réveillon)</td></tr>
    </tbody>
  </table></div>
</section>

<!-- ================================================================ OPTIONS -->
